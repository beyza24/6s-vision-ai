# Copy to .env — never commit .env

# --- Tek model (açıklama / kural) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# --- LLM Council (çoklu model) ---
# Ortak yedek anahtar (isteğe bağlı)
COUNCIL_API_KEY=

# Üyeler: provider:model,virgülle
# Örnek OpenRouter ile birden fazla evrensel model:
# COUNCIL_MEMBERS=openrouter:openai/gpt-4o-mini,openrouter:anthropic/claude-3.5-sonnet,openrouter:google/gemini-flash-1.5
COUNCIL_MEMBERS=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

GOOGLE_API_KEY=
GOOGLE_BASE_URL=

# Anahtar yoksa sistem otomatik fake council kullanır (demo/hakem için yeterli).
